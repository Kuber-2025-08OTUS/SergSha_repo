[all]
%{ for vm in master ~}
${ vm["name"] } ansible_host=${ vm.network_interface[0].ip_address }
%{ endfor ~}
%{ for vm in worker ~}
${ vm["name"] } ansible_host=${ vm.network_interface[0].ip_address }
%{ endfor ~}

[master]
%{ for vm in master ~}
${ vm["name"] }
%{ endfor ~}

[worker]
%{ for vm in worker ~}
${ vm["name"] }
%{ endfor ~}
